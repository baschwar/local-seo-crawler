{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local SEO Auditor",
  "version": "0.1.0",
  "identifier": "com.local-seo-auditor.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Local SEO Auditor",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": ["resources/sidecar"]
  }
}
